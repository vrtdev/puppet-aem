<%- | 
  Hash $properties,
  String $pid
| -%>
service.pid="<%= $pid %>"
<%- $properties.keys.each | String $key | { -%>
  <%- if $properties[$key] =~ Array { -%>
<%= $key -%>=["<%= $properties[$key].join('","') -%>"]
  <%- } elsif $properties[$key] =~ String and $properties[$key] =~ /^[T]".*"$/ { -%>
<%= $key -%>=<%= $properties[$key].match(/^[T](".*")$/)[1] -%>

  <%- } elsif $properties[$key] =~ String and $properties[$key] =~ /^[I|L|F|D|X|S|C|B]".*"$/ { -%>
<%= $key -%>=<%= $properties[$key] -%>

  <%- } else {-%>
    <%- if $properties[$key] =~ Boolean { -%>
      <%- $type = "B" -%>
    <%- } elsif $properties[$key] =~ Integer {-%>
      <%- $type = "L" -%>
    <%- } else { -%>
      <%- $type = "" -%>
    <%- } -%>
<%= $key -%>=<%= $type -%>"<%= $properties[$key] -%>"
  <%- } -%>
<%- } -%>
